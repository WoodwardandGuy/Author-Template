# Google Tag Manager Container ID
# GA4 is configured as a tag inside GTM
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Meta (Facebook) Pixel ID
# Get your Pixel ID from https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Resend API Key for Email Notifications
RESEND_API_KEY=re_123456789

# Sanity CMS
# Create a project at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API Read Token (server-only, for draft mode / visual editing)
# Create at https://sanity.io/manage → API → Tokens → Add token (Viewer)
SANITY_API_READ_TOKEN=
