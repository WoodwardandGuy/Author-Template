# Canonical site URL (no trailing slash) — used for metadata, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://example.com

# Sanity CMS
# Create a project at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API Read Token (server-only, for draft mode / visual editing)
# Create at https://sanity.io/manage → API → Tokens → Add token (Viewer)
SANITY_API_READ_TOKEN=

# Sanity webhook secret for on-publish revalidation (see app/api/revalidate/route.ts)
SANITY_REVALIDATE_SECRET=

# Google Analytics 4 — lives in the client's GA account. Pageviews only, no ads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form (Resend) — https://resend.com
RESEND_API_KEY=
# FROM address must be on a domain verified in your Resend account
CONTACT_FROM_EMAIL=contact@yourdomain.com
# Where contact-form messages are delivered (kept server-side, never exposed)
CONTACT_TO_EMAIL=you@yourdomain.com

# Newsletter provider (Flodesk) — https://flodesk.com
# API key: Flodesk → Settings → Integrations → API. See app/api/newsletter/route.ts
NEWSLETTER_API_KEY=
# Flodesk segment id to add subscribers to (optional; omit to add with no segment)
NEWSLETTER_LIST_ID=
